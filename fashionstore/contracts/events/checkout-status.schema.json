{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashionstore.example/contracts/events/checkout-status.schema.json",
  "title": "CheckoutStatus",
  "description": "SNS message published to checkout-status by process-checkout (or re-published by the store-api reconciler) after the outcome commits. Consumers must treat it as at-least-once and dedupe on checkout_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkout_id", "status", "order_id", "user_sub", "email", "total_cents", "occurred_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "checkout_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "status": { "enum": ["CONFIRMED", "REJECTED"] },
    "reason": { "type": ["string", "null"], "enum": [null, "OUT_OF_STOCK", "PAYMENT_DECLINED", "UNKNOWN_SKU"] },
    "order_id": { "type": "integer", "minimum": 1 },
    "user_sub": { "type": "string", "minLength": 1, "maxLength": 64 },
    "email": { "type": "string", "maxLength": 254 },
    "total_cents": { "type": "integer", "minimum": 0 },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "REJECTED" } } },
      "then": { "required": ["reason"], "properties": { "reason": { "type": "string" } } }
    }
  ]
}
